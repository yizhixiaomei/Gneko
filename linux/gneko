#!/usr/bin/env sh
# Gneko Linux 启动器：直接跑源码，参数原样透传
# 用法： ./gneko          （默认皮肤）
#        ./gneko --skin mint --scale 3
set -eu

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
# linux/ 目录在仓库里，启动器回到仓库根
APP_DIR=$(cd "$SELF_DIR/.." && pwd)

# 打包成 tar.gz 解压后根目录就叫 Gneko-<ver>/，两种布局都能跑
if [ ! -f "$APP_DIR/Gneko.py" ]; then
    APP_DIR=$SELF_DIR
fi

cd "$APP_DIR"
exec python3 "$APP_DIR/Gneko.py" "$@"
